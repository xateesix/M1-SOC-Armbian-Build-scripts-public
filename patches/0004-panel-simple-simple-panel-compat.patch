+/* Factory RK3308 DT uses legacy "simple-panel" + display-timings (5.10 binding). */
+static struct panel_desc *panel_simple_desc_from_timing(struct device *dev,
+						struct display_timing *timing)
+{
+	struct panel_desc *desc;
+	struct videomode vm;
+	unsigned int bus_flags;
+	u32 bus_format;
+
+	desc = devm_kzalloc(dev, sizeof(*desc), GFP_KERNEL);
+	if (!desc)
+		return ERR_PTR(-ENOMEM);
+
+	desc->timings = timing;
+	desc->num_timings = 1;
+	desc->bpc = 8;
+	desc->connector_type = DRM_MODE_CONNECTOR_DPI;
+	if (!of_property_read_u32(dev->of_node, "bus-format", &bus_format))
+		desc->bus_format = bus_format;
+
+	videomode_from_timing(timing, &vm);
+	drm_bus_flags_from_videomode(&vm, &bus_flags);
+	desc->bus_flags = bus_flags;
+
+	of_property_read_u32(dev->of_node, "width-mm", &desc->size.width);
+	of_property_read_u32(dev->of_node, "height-mm", &desc->size.height);
+
+	return desc;
+}
+
+static struct panel_desc *panel_simple_from_display_timings(struct device *dev)
+{
+	struct device_node *timings_np;
+	struct display_timings *timings;
+	struct display_timing *timing;
+	struct panel_desc *desc;
+	static const char * const fallback_names[] = { "timing3", "timing0", NULL };
+	int i;
+
+	timings = of_get_display_timings(dev->of_node);
+	if (timings) {
+		timing = display_timings_get(timings, timings->native_mode);
+		if (!timing)
+			timing = display_timings_get(timings, 0);
+		if (!timing) {
+			display_timings_release(timings);
+			dev_err(dev, "display-timings: no usable mode\n");
+			return ERR_PTR(-EINVAL);
+		}
+
+		timing = devm_kmemdup(dev, timing, sizeof(*timing), GFP_KERNEL);
+		display_timings_release(timings);
+		if (!timing)
+			return ERR_PTR(-ENOMEM);
+
+		return panel_simple_desc_from_timing(dev, timing);
+	}
+
+	timings_np = of_get_child_by_name(dev->of_node, "display-timings");
+	if (!timings_np) {
+		dev_err(dev, "missing display-timings node\n");
+		return ERR_PTR(-ENODEV);
+	}
+
+	timing = devm_kzalloc(dev, sizeof(*timing), GFP_KERNEL);
+	if (!timing) {
+		of_node_put(timings_np);
+		return ERR_PTR(-ENOMEM);
+	}
+
+	for (i = 0; fallback_names[i]; i++) {
+		if (!of_get_display_timing(timings_np, fallback_names[i], timing))
+			break;
+	}
+	of_node_put(timings_np);
+
+	if (fallback_names[i]) {
+		desc = panel_simple_desc_from_timing(dev, timing);
+		if (!IS_ERR(desc))
+			dev_info(dev, "using fallback timing %s\n", fallback_names[i]);
+		return desc;
+	}
+
+	dev_err(dev, "failed to parse display-timings\n");
+	return ERR_PTR(-ENODEV);
+}
+
