# Copy to config.env and set BUILD_ARTIFACTS_URL, or run ./configure.sh
# Published firmware defaults: m1prox1 / m1prox1, no WiFi

BUILD_ARTIFACTS_URL=""
FACTORY_FIRMWARE_DIR=""
FETCH_ARMBIAN_SOURCE="0"
FETCH_KERNEL_SOURCE="0"
BUILD_ARMBIAN_PATH="/home/build/armbian-build"
KERNEL_SRC_PATH="/home/build/linux-v6.18"

WIFI_SSID=""
WIFI_PASSWORD=""
WIFI_COUNTRY="US"

ROOT_PASSWORD="m1prox1"
USER_NAME="m1prox1"
USER_PASSWORD="m1prox1"
USER_REALNAME="M1 Pro X1 Operator"
LOCALE="en_US.UTF-8"
TIMEZONE="America/New_York"

SERIAL_GETTY="ttyFIQ0"
SERIAL_BAUD="1500000"

RELEASE="bookworm"
KERNEL_BRANCH="current"
UBOOT_DEFCONFIG="evb-rk3308_defconfig"